<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.taco-artist-editor.semanal</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__RUTA_REPO__/bin/sync_semanal.py</string>
    <string>--rama</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__RUTA_REPO__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__RUTA_REPO__/.cache/sync.log</string>
  <key>StandardErrorPath</key>
  <string>__RUTA_REPO__/.cache/sync-error.log</string>
</dict>
</plist>
